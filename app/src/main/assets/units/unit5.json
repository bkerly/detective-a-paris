  "story": {
    "intro": [
      {
        "scene": "station",
        "text": "Wednesday morning. {name} goes to le commissariat: the police station. The police will want to know what the thieves looked like."
      },
      {
        "scene": "people",
        "people": [
          {
            "hair": "22223b",
            "hairStyle": "short",
            "hat": "beret",
            "hatColor": "22223b",
            "clothes": "ffffff",
            "stripes": "1d2b53",
            "moustache": true,
            "tall": false
          },
          {"hair": "b5484d", "hairStyle": "long", "hat": "hat", "hatColor": "22223b", "clothes": "d9534f", "glasses": true, "tall": true}
        ],
        "text": "She shuts her eyes and sees them again. Now she needs the French words to describe them."
      }
    ],
    "toPolice": [
      {"scene": "station", "text": "Inside le commissariat an officer sits at a desk, with paper and a sharp pencil."}
    ],
    "toInspector": [
      {
        "scene": "station",
        "text": "The officer takes her drawing of the thief to the next room. A man in a grey coat comes out. He is the inspector, and he wants to know about the lady."
      }
    ],
    "toMarket": [
      {
        "scene": "marketview",
        "text": "Outside there is a street market: le marché. And between the stalls… a beret. A striped pull. A moustache!",
        "line": {"who": "hero", "fr": "Le voilà !", "en": "There he is!"}
      },
      {
        "scene": "icon:net",
        "text": "Nobody gets hurt in this story. To catch a voleur, a detective needs one thing: a very big net. Who at a market has a big net?"
      }
    ],
    "outro": [
      {
        "scene": "netted",
        "text": "Got him! The police take the voleur away. But he does not have the briefcase.",
        "line": {
          "who": "thief",
          "fr": "La mallette ? C'est la dame !",
          "gloss": ["la mallette = the briefcase", "la dame = the lady"]
        }
      },
      {
        "scene": "watching",
        "text": "Across the street, a grande lady in a manteau rouge watches. She has the briefcase. She looks hard at {name}. Now she knows the detective's face."
      }
    ]
  },
