  "tips": [
    {
      "id": "e_ending",
      "title": "A little e for her",
      "text": "Many describing words add an -e for a woman. Il est grand. Elle est grande. The extra e makes you say the last letter: gran, then grand-uh."
    },
    {
      "id": "after_noun",
      "title": "The colour comes after",
      "text": "In English you say a red hat. In French the colour comes after the thing: un chapeau rouge, les cheveux noirs."
    },
    {
      "id": "storybook",
      "title": "A storybook thief",
      "text": "The thief wears a beret and a striped sailor top called a marinière, because he is a storybook thief. Few French people dress like that. Scarves, though, are worn most of the year."
    },
    {
      "id": "commissariat",
      "title": "Le commissariat",
      "text": "A police station is le commissariat. Look for the blue, white and red flag over the door."
    }
  ],
