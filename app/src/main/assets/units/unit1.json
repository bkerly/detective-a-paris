  "story": {
    "intro": [
      {"scene": "office", "text": "{name} is a private detective. People come to her with puzzles that nobody else can solve."},
      {"scene": "office_letter", "text": "One morning a letter comes. The stamp is from France, a country far away across the sea."},
      {
        "scene": "letter",
        "text": "Chère {name},\nSomeone wants to steal a painting from my museum. I need the best detective in the world. Please come to Paris! Your plane leaves today.\nMonsieur Noir\nDirector, Musée d'Orsay",
        "note": "\"Chère\" means Dear. A museum is a building that keeps famous paintings safe so everyone can see them."
      },
      {"scene": "map", "text": "Paris is the biggest city in France. The people there speak French, and {name} does not know a single word of it."},
      {"scene": "notebook", "text": "She opens her notebook. There is just enough time to learn a few words before the plane leaves."}
    ],
    "toAirport": [
      {
        "scene": "airport",
        "text": "{name} goes to the airport. Her plane belongs to a French airline, so the people at the desk speak French. Time to try out those words!"
      }
    ],
    "toCheck": [
      {
        "scene": "hall",
        "text": "Before the gates comes the bag check. Every bag goes through a machine, and a man looks at the pictures. He speaks French too."
      }
    ],
    "toGate": [
      {"scene": "hall", "text": "She has her ticket, but the plane leaves soon. Read the signs and find the gate!"}
    ],
    "outro": [
      {
        "scene": "cabin",
        "text": "{name} steps onto the plane just in time.",
        "line": {"who": "crew", "fr": "Bonjour, bienvenue !", "en": "Hello, welcome!"}
      },
      {"scene": "sky", "text": "The plane climbs above the clouds. Next stop: Paris. Somewhere down there, a thief is making plans."}
    ]
  },
