  "tips": [
    {
      "id": "bonjour_first",
      "title": "Bonjour comes first",
      "text": "In France you say Bonjour before you ask for anything: in a shop, at a desk, on a bus. If you forget, people may think you are rude."
    },
    {
      "id": "madame_monsieur",
      "title": "Madame and Monsieur",
      "text": "Call a grown-up woman Madame and a grown-up man Monsieur. \"Bonjour, Madame\" is the polite way to say hello."
    },
    {
      "id": "try_french",
      "title": "Try French first",
      "text": "It is polite to try French first, even if you get it wrong. After that you can ask: Parlez-vous anglais ?"
    },
    {
      "id": "voila",
      "title": "Voilà !",
      "text": "Voilà means here it is, or there you go. People say it all the time in France, when they hand something over or when a job is done."
    }
  ],
