  "story": {
    "intro": [
      {
        "scene": "icon:hole",
        "text": "{name} crawls through the hole behind the Rivoli sign. On the other side: a great hall, full of mice, cheese and little red, white and blue flags."
      },
      {
        "scene": "hall",
        "text": "The mice are shouting and waving. « Vive la révolution ! » A mouse in a red cap runs up to {name}. She knows that face!",
        "line": {"who": "crowd", "fr": "Vive la révolution !"}
      },
      {"scene": "notebook", "text": "Some mice are kind, some may be mean. To tell them apart, {name} needs words for good and bad."}
    ],
    "toGeorges": [
      {"scene": "hall", "text": "It is the mouse from the clothes shop! The one {name} caught in her net, and let go in the street."}
    ],
    "toKing": [
      {
        "scene": "throne",
        "text": "At the back of the hall, behind a wall of cheese crates, sit two mice in crowns: King Loir XVI and Queen Sourie Antoinette.",
        "note": "Un loir is a dormouse. Une souris is a mouse."
      }
    ],
    "toCheese": [
      {
        "scene": "hall",
        "text": "Up the ladder, in the street, stands the red truck, full of cheese. Everyone is hungry: king, queen and mice.",
        "line": {
          "who": "georges",
          "fr": "Madame, aidez-nous ! Le fromage, pour tout le monde !",
          "gloss": ["aidez-nous = help us"]
        }
      }
    ],
    "outro": [
      {
        "scene": "hall",
        "text": "Every mouse has cheese. Nobody is hungry now, not even the king.",
        "line": {"who": "crowd", "fr": "Vive la détective !"}
      },
      {
        "scene": "throne",
        "text": "But there is not enough cheese in Paris for every mouse, every day. Someone must talk to the people who make the cheese.",
        "line": {
          "who": "king",
          "fr": "Madame, vous parlez français. Aidez-nous encore !",
          "gloss": ["encore = again"]
        }
      }
    ]
  },
