  "tips": [
    {
      "id": "aop",
      "title": "AOP and IGP",
      "text": "AOP stands for appellation d'origine protégée. The red and yellow label means a cheese was made in its home region in the old way, like Brie de Meaux, Comté and Roquefort. IGP, in blue and yellow, is a looser label that ties a food to a region."
    },
    {
      "id": "cheeses",
      "title": "So many cheeses",
      "text": "People say France has a different cheese for every day of the year. Each region has its own, made from the milk of cows, goats or sheep."
    },
    {
      "id": "order",
      "title": "First, then, after",
      "text": "To tell things in order, start with d'abord, go on with puis, and then après. Many stories end with alors: so."
    }
  ],
