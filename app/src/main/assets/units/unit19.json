    "intro": [
      {
        "scene": "icon:panther",
        "text": "The panther necklace comes from Cartier, a great jewellery house. Its shop is at 13 rue de la Paix, a few steps from the Ritz."
      },
      {"scene": "front", "text": "{name} will go in as a shopper, and look at how the shop keeps its jewels safe. First she needs jewellery words."}
    ],
    "toShop": [
      {"scene": "front", "text": "She rings the bell. The door clicks open. Inside, everyone speaks quietly."},
      {"scene": "inside", "text": "Glass cases shine with rings and necklaces. A jeweller in black smiles at her."}
    ],
    "toShoppers": [
      {
        "scene": "inside",
        "text": "The shop is busy today. People buy jewellery for weddings, for birthdays, for Christmas. {name} wonders: does everyone here have a reason?"
      }
    ],
