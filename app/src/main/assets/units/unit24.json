  "story": {
    "intro": [
      {"scene": "lobby", "text": "The last night of fashion week. {name} must look right for the show, then get there."},
      {"scene": "notebook", "text": "For a night like this, she needs words for clothes that are smart, or plain, or just right."}
    ],
    "toConcierge": [
      {"scene": "lobby", "text": "In the hall of the Ritz stands the concierge. On his jacket: two crossed gold keys."}
    ],
    "toShow": [
      {"scene": "show", "text": "The show begins. Music, lights, and then Céleste Rivière walks out in a black gown. The panther shines at her neck."},
      {"scene": "show", "text": "Beside {name} sits a famous designer. She loves to talk about clothes."}
    ],
    "toChase": [
      {
        "scene": "taxi",
        "text": "Outside, a taxi waits. The driver is Paul, from her first day in Paris!",
        "line": {
          "who": "hero",
          "fr": "Suivez cette voiture !",
          "gloss": ["suivez = follow"]
        }
      },
      {"scene": "icon:tracker", "text": "The tracker shows the way Céleste's car turns. Tell Paul which way to go."}
    ],
    "outro": [
