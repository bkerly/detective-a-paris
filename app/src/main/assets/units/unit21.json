  "tips": [
    {
      "id": "librairie",
      "title": "Bookshop or library?",
      "text": "In French, a bookshop and a library are different words, and the one that sounds like library is the bookshop. La librairie: you buy books. La bibliothèque: you borrow them."
    },
    {
      "id": "tumbleweeds",
      "title": "Beds among the books",
      "text": "Shakespeare and Company sells English books, across the river from Notre-Dame. Since the 1950s young writers have slept there for free, on beds between the shelves. They are called Tumbleweeds."
    },
    {
      "id": "rules",
      "title": "The three rules",
      "text": "A Tumbleweed must help in the shop, read a book a day, and write a one-page story of their life for the shop to keep."
    }
  ],
