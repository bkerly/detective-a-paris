  "story": {
    "intro": [
      {
        "scene": "front",
        "text": "Shakespeare and Company is a bookshop of English books, on the left bank of the Seine, across the river from Notre-Dame."
      },
      {"scene": "notebook", "text": "A bookshop in Paris has its own French words. And there is a trap: one of them sounds like the wrong English word."}
    ],
    "toShop": [
      {"scene": "inside", "text": "Inside, books go up to the ceiling. A cat sleeps on a chair. A young woman with red hair stacks books by the till."}
    ],
    "toSearch": [
      {"scene": "inside", "text": "If the man slept here, his page might still be here. {name} looks under things, behind things, and on top of things."}
    ],
    "outro": [
      {
        "scene": "letter",
        "text": "Ma vie\nJe m'appelle Hugo. J'ai trente ans.\nJ'aime les livres, la nuit, et le cinéma.\nJ'aime Céleste Rivière.\nPour elle, je fais tout.\nHugo"
      },
      {
        "scene": "people",
        "people": [
          {"hair": "b5484d", "hairStyle": "short", "clothes": "6b4a2f", "scarf": "3a9e6a", "glasses": true}
        ],
        "text": "The man with the book is called Hugo. He loves Céleste Rivière, the film star, and he will do anything she asks."
      },
      {
        "scene": "people",
        "people": [
          {"hair": "22223b", "hairStyle": "long", "clothes": "7a1f2b", "scarf": "f2b233"}
        ],
        "text": "So the thief and the actress are close. What does that mean? {name} does not know yet."
      }
    ]
  },
