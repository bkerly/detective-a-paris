  "tips": [
    {
      "id": "bonsoir",
      "title": "Bonjour or Bonsoir?",
      "text": "From about six in the evening, people say Bonsoir instead of Bonjour. It still comes first, before you ask for anything."
    },
    {
      "id": "un_une",
      "title": "Un and une",
      "text": "Un and une both mean a. Every French thing is either an un word or an une word: un jus, une limonade. There is no trick to it. You learn the little word along with the big one."
    },
    {
      "id": "croque",
      "title": "Crunch-mister",
      "text": "A croque-monsieur is a hot sandwich of ham and melted cheese. Children in France often drink a sirop: fruit syrup in a glass of water."
    },
    {
      "id": "waiter",
      "title": "In a French café",
      "text": "To call the waiter, catch his eye and say: Monsieur, s'il vous plaît ! The bill comes only when you ask for it, and you may sit as long as you like."
    }
  ],
