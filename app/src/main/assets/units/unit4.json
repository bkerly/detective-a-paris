  "story": {
    "intro": [
      {
        "scene": "paris_night",
        "text": "Tuesday evening. In one hour {name} must be at Le Procope, the oldest café in Paris. It has been serving drinks for more than 300 years."
      },
      {"scene": "notebook", "text": "A detective cannot think on an empty stomach. Before the meeting, she learns how to order."}
    ],
    "toCafe": [
      {"scene": "procope", "text": "Le Procope, 20 h. {name} is on time. Monsieur Noir is not here yet, so she takes a table. A waiter is on his way."}
    ],
    "helper": [
      {
        "scene": "table",
        "text": "A young woman hurries in and sits down. \"Monsieur Noir sent me,\" she whispers. She puts a briefcase on the table.",
        "note": "A briefcase is a flat case for carrying papers."
      },
      {
        "scene": "table",
        "text": "\"The night key of the museum is inside. And a map of every room.\"",
        "line": {"who": "helper", "fr": "La clé est ici.", "en": "The key is here."}
      },
      {"scene": "grab", "text": "Before anyone can open it, a hand shoots out. A man grabs the briefcase and runs!"}
    ],
    "look": [
      {
        "scene": "scooter",
        "text": "A scooter is waiting with its engine running, and a lady sits on it. The thief jumps on behind her. Vroom! They are gone."
