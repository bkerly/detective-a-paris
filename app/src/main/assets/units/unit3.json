  "tips": [
    {
      "id": "days",
      "title": "Days and dates",
      "text": "French days do not start with a capital letter. Dates put the day before the month: 14/7 is the 14th of July."
    },
    {
      "id": "after_twenty",
      "title": "After twenty",
      "text": "After vingt you just add the small number: vingt-deux, vingt-trois, vingt-quatre. Only 21 and 31 slip in an extra word: vingt et un, trente et un."
    },
    {
      "id": "clock24",
      "title": "The clock counts to 24",
      "text": "In France, times after midday keep counting: 13 h, 14 h, and so on. So 20 h is 8 o'clock at night. To work it out, take 12 away."
    },
    {
      "id": "floors",
      "title": "Which floor?",
      "text": "The floor at street level is the rez-de-chaussée. The premier étage is the first floor up the stairs. So room 12 is not at street level."
    },
    {
      "id": "breakfast",
      "title": "A French breakfast",
      "text": "Hotel breakfast is bread, butter and jam, and perhaps a croissant. Many people dip their bread in a bowl of hot chocolate."
    }
  ],
