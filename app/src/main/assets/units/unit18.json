    ],
    "theCase": [
      {"scene": "icon:panther", "text": "Then he tells her the case. It is fashion week in Paris, when the great fashion houses show their new clothes."},
      {
        "scene": "people",
        "people": [
          {"hair": "22223b", "hairStyle": "long", "clothes": "7a1f2b", "scarf": "f2b233"}
        ],
        "text": "On the last night, the film star Céleste Rivière, the new Marion Cotillard, will walk the runway wearing a famous necklace from Cartier: a panther, made of diamonds."
      },
      {"scene": "icon:thief", "text": "Monsieur Noir has heard that thieves plan to steal it. He wants {name} to stop them."}
    ],
    "toFollowed": [
      {"scene": "chase", "text": "Monsieur Noir looks in the mirror, and his face goes white."}
    ],
    "toChase": [
      {"scene": "chase", "text": "At a red light they swap seats. {name} takes the wheel. Monsieur Noir watches the van and calls the way."}
    ],
    "outro": [
      {
        "scene": "river",
        "text": "The green car flies off the ramp, over the Seine, and lands on the far quai. The red van stops at the edge of the water.",
        "line": {
          "who": "noir",
          "fr": "Bravo, Madame ! Vous conduisez très bien !",
          "gloss": ["vous conduisez = you drive"]
        }
      },
      {"scene": "icon:panther", "text": "Who was in the van? Nobody knows. Tomorrow {name} will go to the shop where the panther necklace is kept."}
    ]
