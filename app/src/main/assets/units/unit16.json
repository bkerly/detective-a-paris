  "story": {
    "intro": [
      {
        "scene": "paris_night",
        "text": "Ce soir, tout le monde est content: the mice, the king, the cheese office, and Paul the driver. The mice want to take {name} out to celebrate."
      },
      {"scene": "notebook", "text": "A night out needs new words: what shall we do tonight, and where shall we go?"}
    ],
    "toPlans": [
      {"scene": "outside", "text": "Georges Raton is waiting outside the hotel, in his best red cap."}
    ],
    "toDoor": [
      {"scene": "outside", "text": "Le Moulin Rouge ! The red windmill turns slowly on the roof. There is a long line at the door…"}
    ],
    "toKitchen": [
      {
        "scene": "icon:kitchen",
        "text": "Round the back, the kitchen door is open. In they go! Keep out of sight of the stage manager and the head waiter: if one of them sees you, you are walked back to the last door.",
        "note": "Get a lemonade at the bar, then sit at your table."
      }
    ],
    "outro": [
      {"scene": "show", "text": "Le spectacle commence ! The dancers kick high: le cancan. The mice cheer from under the table."},
      {
        "scene": "show",
        "text": "At the end of the bar, a tall man in a black coat raises a glass of lemonade.",
        "line": {
          "who": "noir",
          "fr": "À votre santé, Madame !",
          "gloss": ["à votre santé = cheers, to your health"]
        }
      },
      {
        "scene": "people",
        "people": [
          {"hair": "22223b", "hairStyle": "short", "hat": "hat", "hatColor": "22223b", "clothes": "22223b", "scarf": "d9534f", "moustache": true}
        ],
        "text": "Monsieur Noir! He knew all along that {name} would solve it.",
        "line": {
          "who": "noir",
          "fr": "Le fromage, les souris, le roi… Bravo ! Vous êtes une vraie détective.",
          "gloss": ["une vraie détective = a real detective"]
        }
      },
      {
        "scene": "paris_night",
        "text": "The case of the stolen cheese is closed. But Paris is full of puzzles, and a good detective is never idle for long. À bientôt !"
      }
    ]
  },
