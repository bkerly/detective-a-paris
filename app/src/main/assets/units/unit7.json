  "story": {
    "intro": [
      {
        "scene": "icon:cathedral",
        "text": "{name} porte un chapeau jaune et une écharpe verte. Now she must get to Notre-Dame, the great church on the island."
      },
      {"scene": "notebook", "text": "The stranger may tell her where something is hidden. She needs the little words: on, under, behind."}
    ],
    "toStreet": [
      {"scene": "street", "text": "Où est Notre-Dame ? {name} has a map, but Paris is big. When you are lost on foot, you ask."}
    ],
    "toBridge": [
      {"scene": "bridge", "text": "{name} est sur le pont. La rivière est sous le pont. Et la cathédrale ? Is this the right way? A man is coming."}
    ],
    "toChurch": [
      {
        "scene": "ringer",
        "text": "Dans la cathédrale, a man sees le chapeau jaune et l'écharpe verte. He rings the bells here. He is too scared to talk. He pushes a note into her hand and hurries away."
      },
      {"scene": "icon:note", "text": "The note says:\n\"Derrière l'autel, sous le livre.\"", "note": "He has hidden his papers. Find them!"}
    ],
    "outro": [
      {
        "scene": "icon:page",
        "text": "Outside, {name} puts the pages in order. They say:\n\"Ce soir. Musée d'Orsay. Les nymphéas.\"",
        "note": "Ce soir means tonight. Les nymphéas are water lilies: famous paintings by Claude Monet."
      },
      {"scene": "paris_night", "text": "Tonight the lady will use the stolen key to get into the museum. {name} must be there first."}
    ]
  },
