  "story": {
    "intro": [
      {
        "scene": "letter",
        "text": "Madame,\nI know what the lady plans. Meet me at Notre-Dame. Portez un chapeau jaune et une écharpe verte. Then I will know you, and she will not.\nUn ami",
        "note": "\"Portez\" means wear. \"Un ami\" is a friend. The note was pushed under the door of room 12."
      },
      {
        "scene": "icon:hat",
        "text": "Un chapeau jaune et une écharpe verte. {name} owns neither. And the lady knows her face now, so a new look is a good idea."
      },
      {"scene": "notebook", "text": "Time to go shopping. First, the words."}
    ],
    "toShop": [
      {"scene": "front", "text": "A small shop in a side street. The sign says CHAPEAUX: hats."},
      {"scene": "hatshop", "text": "Inside there are hats to the ceiling, and a man brushing one of them."}
    ],
    "toScarves": [
      {"scene": "front2", "text": "Un chapeau jaune: done. Next door is a little shop full of scarves."},
      {"scene": "inside", "text": "Scarves in every colour hang on the walls, and a lady with glasses is folding them."}
    ],
    "mouse": [
      {
        "scene": "panic",
        "text": "Something small and grey runs across the floor. The customers jump onto the chairs!",
        "line": {"who": "customer", "fr": "Une souris ! Une souris !"}
      },
      {"scene": "icon:net", "text": "Good thing a detective keeps her net. The shop lady can see la souris from her counter. She will shout where it is."}
    ],
    "outro": [
      {"scene": "dressed", "text": "Outside, {name} lets la souris go. It runs off down the street, quite unhurt."},
      {
        "scene": "inside",
        "text": "The shop lady is so pleased that she gives {name} a present.",
        "line": {
          "who": "owner",
          "fr": "Merci, Madame ! Voilà des gants. C'est un cadeau !",
          "gloss": ["des gants = gloves", "un cadeau = a present"]
        }
      },
      {"scene": "icon:cathedral", "text": "Chapeau jaune, écharpe verte. Now the stranger will know her. Next stop: Notre-Dame."}
    ]
  },
