  "tips": [
    {
      "id": "verte",
      "title": "Vert or verte?",
      "text": "Une écharpe is an une word, so vert takes a little e: une écharpe verte. Jaune and rouge end in e already, so they never change."
    },
    {
      "id": "magasins",
      "title": "Where Paris shops",
      "text": "Paris has grands magasins: big old department stores, such as Galeries Lafayette with its glass dome. It also has small boutiques and flea markets, where old things are sold in the street."
    },
    {
      "id": "tens",
      "title": "Counting in tens",
      "text": "Dix, vingt, trente, quarante, cinquante, soixante: 10, 20, 30, 40, 50, 60. For the numbers in between, add the small one: quarante-cinq is 45."
    },
    {
      "id": "manners",
      "title": "Shop manners",
      "text": "Say Bonjour when you walk into a shop and Au revoir when you leave, even if you buy nothing. The shop is a little like someone's home."
    }
  ],
