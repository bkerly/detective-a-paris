  "story": {
    "intro": [
      {"scene": "steps", "text": "The man ran down into Opéra station, at the end of the rue de la Paix. {name} has never ridden the Paris metro."},
      {"scene": "icon:navigo", "text": "And the way to pay has just changed. First she needs metro words."}
    ],
    "toWindow": [
      {"scene": "window", "text": "There is a ticket window by the gates. A man in a blue cap sits behind the glass."}
    ],
    "toPlatform": [
      {
        "scene": "platform",
        "text": "She taps through the gate and runs down to the platform. There he is! He sees her, and jumps onto a train just as the doors close."
      },
      {
        "scene": "platform",
        "text": "The train is gone. But the man dropped something. A woman picks it up.",
        "line": {
          "who": "woman",
          "fr": "Monsieur ! Votre livre !",
          "gloss": ["votre livre = your book"]
        }
      }
    ],
    "toRide": [
      {
        "scene": "icon:metro_line",
        "text": "Line 7, from Opéra to Jussieu. Then change to line 10, as far as Cluny–La Sorbonne. Read the signs, and count the stops."
      }
    ],
    "outro": [
      {"scene": "bookshop_front", "text": "Out of the metro, along the river, opposite Notre-Dame. There it is: a green shopfront, full of books."},
      {"scene": "icon:bookshop", "text": "Shakespeare and Company. Is the man inside?"}
    ]
  },
