  "tips": [
    {
      "id": "metro",
      "title": "The Paris metro",
      "text": "The metro opened in 1900. Each line has a number and a colour. The direction is named after the last station on the line, so you must know where the line ends."
    },
    {
      "id": "pay",
      "title": "No more paper tickets",
      "text": "Paper tickets were used for more than a hundred years. They stopped being sold in November 2025. Now you tap a Navigo Easy card at the gate, or hold your phone over the reader with a ticket from an app. A ride costs 2 euros 55 and lasts two hours, changes included."
    },
    {
      "id": "quai",
      "title": "Two kinds of quai",
      "text": "Le quai is a street along the river. In the metro, le quai is the platform where you wait for the train."
    }
  ],
